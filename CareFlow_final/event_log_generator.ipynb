#GENERATE DOCTORS Part 4

#============================================================

doctor_records = []

for i in range(1, NUM_DOCTORS + 1):

    specialization = random.choice(SPECIALIZATIONS)

    # ---------------------------------------------
    # Department Mapping
    # ---------------------------------------------

    if specialization == "General Medicine":
        department = "General Medicine"

    elif specialization == "Cardiology":
        department = "Cardiology"

    elif specialization == "Neurology":
        department = "Neurology"

    elif specialization == "Orthopedics":
        department = "Orthopedics"

    elif specialization == "Radiology":
        department = "Radiology"

    elif specialization == "Emergency Medicine":
        department = "Emergency"

    elif specialization == "Critical Care":
        department = "ICU"

    elif specialization == "Pulmonology":
        department = "General Medicine"

    elif specialization == "Nephrology":
        department = "General Medicine"

    else:
        department = "General Medicine"

    # ---------------------------------------------
    # Doctor Record
    # ---------------------------------------------

    doctor_records.append({

        "Doctor_ID": generate_doctor_id(i),

        "Doctor_Name": generate_doctor_name(),

        "Department": department,

        "Specialization": specialization,

        "Experience_Years": random.randint(2, 35),

        "Consultation_Fee": random.randint(500, 2000),

        "Shift": random.choice([
            "Morning",
            "Evening",
            "Night"
        ]),

        "Availability": random.choices(
            ["Available", "Busy"],
            weights=[80, 20],
            k=1
        )[0]

    })

# ---------------------------------------------
