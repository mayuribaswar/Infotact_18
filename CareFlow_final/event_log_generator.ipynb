#UTILITY FUNCTIONS Part 2

def generate_event_id():
    """
    Generate Unique Event ID
    """
    return str(uuid.uuid4())

def generate_patient_id(index):
    """
    Generate Patient ID
    Example: P00001
    """
    return f"P{index:05d}"

def generate_doctor_id(index):
    """
    Generate Doctor ID
    Example: DR001
    """
    return f"DR{index:03d}"

def generate_patient_name():
    """
    Generate Random Patient Name
    """
    return fake.name()

def generate_doctor_name():
    """
    Generate Random Doctor Name
    """
    return f"Dr. {fake.name()}"

def generate_age():
    """
    Generate Random Age
    """
    return random.randint(1, 90)

def generate_gender():
    """
    Generate Random Gender
    """
    return random.choices(
    ["Male", "Female"],
    weights=[52, 48],
    k=1
    )[0]

def random_datetime(start_date, end_date):
    """
    Generate Random Datetime Between Two Dates
    """

    total_seconds = int(
        (end_date - start_date).total_seconds()
    )

    random_seconds = random.randint(
        0,
        total_seconds
    )

    return start_date + timedelta(seconds=random_seconds)

def generate_shift(timestamp):

    #Determine Shift Based on Timestamp


    hour = timestamp.hour

    if 6 <= hour < 14:
        return "Morning"

    elif 14 <= hour < 22:
        return "Evening"

    else:
        return "Night"

def generate_bed_number():

    #Generate Bed Number


    return f"BED-{random.randint(1,500):03d}"

def generate_ward():

    #Generate Ward Number


    ward = random.choice([
    "Ward-A",
    "Ward-B",
    "Ward-C",
    "Ward-D",
    "ICU",
    "Emergency"
    ])

    number = random.randint(1,30)

    return f"{ward}-{number:02d}"

def generate_wait_time(min_time, max_time):

    #Generate Waiting Time


    return random.randint(min_time, max_time)

def generate_service_time(min_time, max_time):

    #Generate Service Time


    return random.randint(min_time, max_time)

def probability(percent):
    
    #Returns True based on probability
    #Example:
    #probability(30)
    #means 30% chance


    return random.random() < (percent / 100)

def choose_random(data):
    #Return Random Value


    return random.choice(data)

