#PART 6 : EVENT FLOW GENERATION

#============================================================

def generate_patient_events(patient):

    events = []

    admission_datetime = patient["Admission_Date"]

    current_time = admission_datetime

# =====================================================
# BASE FLOW
# =====================================================

    flow = [

        "Patient Arrival",

        "Registration",

        "Waiting",

        "Doctor Consultation"

    ]

# =====================================================
# TESTS
# =====================================================

    if probability(70):

        flow.append(

            random.choice(

                [
    
                    "Blood Test",

                    "Urine Test",

                    "X-Ray",

                    "CT Scan",

                    "MRI",

                    "ECG"

                ]

            )

        )

        flow.append("Doctor Consultation")

# =====================================================
# DIAGNOSIS
# =====================================================

    flow.append("Diagnosis")

# =====================================================
# SURGERY
# =====================================================

    if patient["Severity"] == "Critical":

        if probability(60):

            flow.append("Surgery")

# =====================================================
# ICU
# =====================================================

    if patient["Severity"] == "Critical":

        if probability(75):
    
            flow.append("ICU Admission")

# =====================================================
# WARD
# =====================================================

    if patient["Patient_Type"] != "OPD":

        flow.append("Ward Transfer")

# =====================================================
# TREATMENT
# =====================================================

    flow.append("Treatment")

# =====================================================
# PHARMACY
# =====================================================

    flow.append("Pharmacy")

# =====================================================
# BILLING
# =====================================================

    flow.append("Billing")

# =====================================================
# DISCHARGE
# =====================================================

    flow.append("Discharge")

# =====================================================
# REWORK
# =====================================================

    rework = "No"

    if probability(25):

        diagnosis_index = flow.index("Diagnosis")

        flow.insert(

            diagnosis_index,
    
            random.choice(

                [

                    "Blood Test",

                    "Urine Test",

                    "MRI",

                    "CT Scan"

                ]

            )

        )

        flow.insert(

            diagnosis_index + 1,

            "Doctor Consultation"

        )

        rework = "Yes"

# =====================================================
# GENERATE EVENTS
# =====================================================

    total_wait = 0

    total_service = 0

    for i, activity in enumerate(flow):

        # -----------------------------------------
        # WAIT TIME
        # -----------------------------------------

        if activity == "Waiting":

            wait = generate_wait_time(20, 90)

        elif activity in [
            "MRI",
            "CT Scan"
        ]:

            wait = generate_wait_time(20, 120)

        else:

            wait = generate_wait_time(2, 25)

        # -----------------------------------------
        # SERVICE TIME
        # -----------------------------------------

        if activity == "Surgery":

            service = generate_service_time(90, 240)

        elif activity == "ICU Admission":

            service = generate_service_time(240, 720)

        elif activity == "Treatment":

            service = generate_service_time(30, 120)

        else:

            service = generate_service_time(5, 30)

        # -----------------------------------------
        # UPDATE TIME
        # -----------------------------------------

        total_wait += wait

        total_service += service

        current_time += timedelta(minutes=wait)

        current_time += timedelta(minutes=service)

        # -----------------------------------------
        # PREVIOUS / NEXT ACTIVITY
        # -----------------------------------------

        previous_activity = None

        next_activity = None

        if i > 0:

            previous_activity = flow[i - 1]

        if i < len(flow) - 1:

            next_activity = flow[i + 1]

        # -----------------------------------------
        # DEPARTMENT / RESOURCE
        # -----------------------------------------

        department = ACTIVITY_DEPARTMENT[activity]

        resource = DEPARTMENT_RESOURCE[department]

        # -----------------------------------------
        # DELAY REASON
        # -----------------------------------------

        delay_reason = random.choices(

            DELAY_REASONS,

            weights=[45, 10, 8, 5, 5, 6, 5, 6, 5, 3, 2],

            k=1

        )[0]

        # -----------------------------------------
        # CREATE EVENT
        # -----------------------------------------

        event = {

            "Event_ID": generate_event_id(),

            "Patient_ID": patient["Patient_ID"],

            "Patient_Name": patient["Patient_Name"],

            "Age": patient["Age"],

            "Gender": patient["Gender"],

            "Disease": patient["Disease"],

            "Severity": patient["Severity"],

            "Patient_Type": patient["Patient_Type"],

            "Department": department,

            "Activity": activity,

            "Activity_Status": "Completed",

            "Timestamp": current_time,

            "Event_Order": i + 1,

            "Doctor_ID": patient["Doctor_ID"],

            "Doctor_Name": patient["Doctor_Name"],

            "Shift": generate_shift(current_time),

            "Wait_Time_Minutes": wait,

            "Service_Time_Minutes": service,

            "Total_Process_Time": 0,

            "Rework_Flag": rework,

            "Previous_Activity": previous_activity,

            "Next_Activity": next_activity,

            "Delay_Reason": delay_reason,

            "Resource": resource,

            "Ward": patient["Ward"],

            "Bed_Number": patient["Bed_Number"],

            "Admission_Date": patient["Admission_Date"],

            "Discharge_Date": patient["Discharge_Date"],

            "Outcome": patient["Outcome"],

            "Total_Bill": 0

        }

        # -----------------------------------------
        # ADD EVENT TO LIST
        # -----------------------------------------

        events.append(event)
# =====================================================
# FINAL CALCULATIONS
# =====================================================

    total_process = total_wait + total_service

    bill = 1500

    for activity in flow:

        bill += ACTIVITY_COST.get(activity,0)

    if patient["Severity"] == "Medium":

        bill *= 1.10

    elif patient["Severity"] == "High":

        bill *= 1.30

    elif patient["Severity"] == "Critical":

        bill *= 1.60

    bill = round(bill,2)

    for row in events:

        row["Total_Process_Time"] = total_process

        row["Total_Bill"] = bill

    return events
